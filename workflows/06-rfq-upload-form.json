      "position": [
        0,
        0
      ],
      "webhookId": "6e40cde2-ce7a-4e4b-a525-a5c499ab2cf6"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst customerId = Number(String(item.json.customer || '').split(' ')[0]);\nconst binaryKey = Object.keys(item.binary || {})[0];\nif (!binaryKey) {\n  throw new Error('Please attach the RFQ as a PDF');\n}\n\nreturn [{\n  json: { customer_id: customerId, source_name: item.binary[binaryKey].fileName },\n  binary: { data: item.binary[binaryKey] },\n}];"
      },
      "id": "5a94db5c-ee9b-4ba7-acdc-2ec2846ea5a4",
      "name": "Map form input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "PfRfqEngine00001",
          "mode": "list",
          "cachedResultName": "RFQ: Engine (sub-workflow)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "601be92e-8a13-4a74-a265-38321627efe7",
      "name": "Run RFQ engine",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
